        // Simple RSS fetch function
        function getLatestNewsFromRSS($rssUrl, $limit = 5)
        {
            $cacheFile = '/tmp/vufind_rss_cache_' . md5($rssUrl) . '.txt';
            $cacheTime = 300; // 5 minutes

            // Check cache
            if (file_exists($cacheFile) && (time() - filemtime($cacheFile)) < $cacheTime) {
                $cachedData = file_get_contents($cacheFile);
                return json_decode($cachedData, true);
            }

            $newsItems = [];

            try {
                $rssContent = @file_get_contents($rssUrl, false, stream_context_create([
                    'http' => [
                        'timeout' => 10,
                        'user_agent' => 'VuFind Footer News Bot 1.0',
                    ],
                ]));

                if ($rssContent) {
                    $rss = simplexml_load_string($rssContent);

                    if ($rss && isset($rss->channel->item)) {
                        $count = 0;
                        foreach ($rss->channel->item as $item) {
                            if ($count >= $limit) {
                                 break;
                            }

                            $description = (string)$item->description;
                            $cleanDesc = strip_tags($description);
                            $cleanDesc = html_entity_decode($cleanDesc, ENT_QUOTES, 'UTF-8');
                            if (strlen($cleanDesc) > 150) {
                                $cleanDesc = substr($cleanDesc, 0, 147) . '...';
                            }

                            $newsItems[] = [
                                'title' => (string)$item->title,
                                'link' => (string)$item->link,
                                'description' => $cleanDesc,
                                'pubDate' => (string)$item->pubDate,
                                'formattedDate' => date('d.m.Y', strtotime((string)$item->pubDate)),
                            ];
                            $count++;
                        }
                    }

                    // Cache results
                    file_put_contents($cacheFile, json_encode($newsItems));
                }
            } catch (Exception $e) {
                // Return cached data if available
                if (file_exists($cacheFile)) {
                    $cachedData = file_get_contents($cacheFile);
                    return json_decode($cachedData, true);
                }
            }

            return $newsItems;
        }

        // Fetch the news
        $rssUrl = 'https://blog.bib.uni-mannheim.de/Aktuelles/?feed=rss2&cat=4';
        $latestNews = getLatestNewsFromRSS($rssUrl, 5);
        ?>

        <!-- Latest News Column -->
